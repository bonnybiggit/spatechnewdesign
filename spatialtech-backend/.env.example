# ============================================================
# SPATIAL HEIGHTS TECHNOLOGIES — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# MongoDB Connection
# Local: mongodb://localhost:27017/spatialheights
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/spatialheights
MONGODB_URI=mongodb://localhost:27017/spatialheights

# Email Configuration (for contact form notifications)
# Use your Gmail, Outlook, or SMTP provider credentials
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@spatialheight.com
EMAIL_TO=info@spatialheight.com

# Admin Credentials (for admin panel access)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SpatialHeights2024!

# JWT Secret (for admin authentication)
JWT_SECRET=your-random-secret-key-change-this-in-production
